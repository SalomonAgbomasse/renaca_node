<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Analyse BI - Segmentation Clients</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Futura', Arial, sans-serif;
            font-size: 10px;
            color: #231f20;
            background: #ffffff;
            padding: 15px;
        }

        .header {
            margin-bottom: 25px;
            border-bottom: 2px solid #f1b434;
            padding-bottom: 10px;
        }

        .header h1 {
            font-size: 16px;
            font-weight: bold;
            color: #f1b434;
        }

        .period {
            font-size: 10px;
            color: #666666;
            margin-top: 4px;
        }

        .section-title {
            font-size: 12px;
            font-weight: bold;
            color: #231f20;
            border-left: 3px solid #f1b434;
            padding-left: 8px;
            margin-top: 20px;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th,
        td {
            border: 1px solid #dee2e6;
            padding: 6px 8px;
            text-align: left;
        }

        th {
            background-color: #f1b434;
            color: #ffffff;
            font-weight: bold;
            font-size: 9px;
            text-transform: uppercase;
        }

        tr:nth-child(even) {
            background-color: #f8f9fa;
        }

        .text-right {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        .row-grid {
            display: flex;
            gap: 15px;
        }

        .col-6 {
            flex: 1;
            width: 50%;
        }

        .bar-container {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 5px;
        }

        .bar {
            height: 6px;
            background-color: #f1b434;
            border-radius: 3px;
        }

        .bar-bg {
            width: 60px;
            background-color: #e9ecef;
            border-radius: 3px;
            overflow: hidden;
            display: inline-block;
        }
    </style>
</head>
<body>
    <%
        // Safe list getters to prevent crashes if variables are undefined
        const safeGender = locals.gender || [];
        const safeAge = locals.age || [];
        const safeCapital = locals.capital || [];
        const safeOccupation = locals.occupation || [];
        const safePeriod = locals.period || { startDate: 'Début', endDate: 'Fin' };

        const getPercent = (count, list) => {
            if (!list || !list.length) return 0;
            const total = list.reduce((sum, item) => sum + (item.count || 0), 0);
            return total > 0 ? Math.round((count / total) * 100) : 0;
        };
    %>

    <div class="header">
        <h1>ANALYSE DES CLIENTS - SEGMENTATION</h1>
        <div class="period">Période du <%= safePeriod.startDate %> au <%= safePeriod.endDate %></div>
    </div>

    <div class="row-grid">
        <div class="col-6">
            <div class="section-title">Répartition par Genre</div>
            <table>
                <thead>
                    <tr>
                        <th>Genre</th>
                        <th class="text-right">Contrats</th>
                        <th class="text-right">Prime Moy. (FCFA)</th>
                        <th class="text-right">Capital Moy. (FCFA)</th>
                        <th class="text-right">Part</th>
                    </tr>
                </thead>
                <tbody>
                    <% safeGender.forEach(row => { %>
                    <tr>
                        <td style="font-weight: bold;"><%= row.segment || 'Non défini' %></td>
                        <td class="text-right"><%= (row.count || 0).toLocaleString('fr-FR') %></td>
                        <td class="text-right"><%= (row.avgPrime || 0).toLocaleString('fr-FR') %></td>
                        <td class="text-right"><%= (row.avgCapital || 0).toLocaleString('fr-FR') %></td>
                        <td class="text-right">
                            <div class="bar-container">
                                <div class="bar-bg"><div class="bar" style="<%- `width: ${getPercent(row.count, safeGender)}%` %>"></div></div>
                                <span><%= getPercent(row.count, safeGender) %>%</span>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                    <% if (!safeGender.length) { %>
                    <tr>
                        <td colspan="5" class="text-center">Aucune donnée disponible</td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="col-6">
            <div class="section-title">Répartition par Âge</div>
            <table>
                <thead>
                    <tr>
                        <th>Tranche d'âge</th>
                        <th class="text-right">Contrats</th>
                        <th class="text-right">Prime Moy. (FCFA)</th>
                        <th class="text-right">Capital Moy. (FCFA)</th>
                        <th class="text-right">Part</th>
                    </tr>
                </thead>
                <tbody>
                    <% safeAge.forEach(row => { %>
                    <tr>
                        <td style="font-weight: bold;"><%= row.segment || 'Non défini' %></td>
                        <td class="text-right"><%= (row.count || 0).toLocaleString('fr-FR') %></td>
                        <td class="text-right"><%= (row.avgPrime || 0).toLocaleString('fr-FR') %></td>
                        <td class="text-right"><%= (row.avgCapital || 0).toLocaleString('fr-FR') %></td>
                        <td class="text-right">
                            <div class="bar-container">
                                <div class="bar-bg"><div class="bar" style="<%- `width: ${getPercent(row.count, safeAge)}%` %>"></div></div>
                                <span><%= getPercent(row.count, safeAge) %>%</span>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                    <% if (!safeAge.length) { %>
                    <tr>
                        <td colspan="5" class="text-center">Aucune donnée disponible</td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="section-title">Répartition par Montant (Capital)</div>
    <table>
        <thead>
            <tr>
                <th>Tranche de Capital</th>
                <th class="text-right">Contrats</th>
                <th class="text-right">Prime Moyenne (FCFA)</th>
                <th class="text-right">Durée Moyenne (mois)</th>
                <th class="text-right">Part</th>
            </tr>
        </thead>
        <tbody>
            <% safeCapital.forEach(row => { %>
            <tr>
                <td style="font-weight: bold;"><%= row.segment || 'Non défini' %></td>
                <td class="text-right"><%= (row.count || 0).toLocaleString('fr-FR') %></td>
                <td class="text-right"><%= (row.avgPrime || 0).toLocaleString('fr-FR') %></td>
                <td class="text-right"><%= (row.avgDuration || 0).toLocaleString('fr-FR') %></td>
                <td class="text-right">
                    <div class="bar-container">
                        <div class="bar-bg"><div class="bar" style="<%- `width: ${getPercent(row.count, safeCapital)}%` %>"></div></div>
                        <span><%= getPercent(row.count, safeCapital) %>%</span>
                    </div>
                </td>
            </tr>
            <% }) %>
            <% if (!safeCapital.length) { %>
            <tr>
                <td colspan="5" class="text-center">Aucune donnée disponible</td>
            </tr>
            <% } %>
        </tbody>
    </table>

    <div class="section-title">Top Professions</div>
    <table>
        <thead>
            <tr>
                <th>Profession</th>
                <th class="text-right">Contrats</th>
                <th class="text-right">Prime Moyenne (FCFA)</th>
                <th class="text-right">Capital Moyen (FCFA)</th>
                <th class="text-right">Part</th>
            </tr>
        </thead>
        <tbody>
            <% safeOccupation.slice(0, 15).forEach(row => { %>
            <tr>
                <td style="font-weight: bold;"><%= row.segment || 'Non défini' %></td>
                <td class="text-right"><%= (row.count || 0).toLocaleString('fr-FR') %></td>
                <td class="text-right"><%= (row.avgPrime || 0).toLocaleString('fr-FR') %></td>
                <td class="text-right"><%= (row.avgCapital || 0).toLocaleString('fr-FR') %></td>
                <td class="text-right">
                    <div class="bar-container">
                        <div class="bar-bg"><div class="bar" style="<%- `width: ${getPercent(row.count, safeOccupation)}%` %>"></div></div>
                        <span><%= getPercent(row.count, safeOccupation) %>%</span>
                    </div>
                </td>
            </tr>
            <% }) %>
            <% if (!safeOccupation.length) { %>
            <tr>
                <td colspan="5" class="text-center">Aucune donnée disponible</td>
            </tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>