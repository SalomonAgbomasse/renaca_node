<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CONDITIONS PARTICULIÈRES - OBSÈQUES ALAFIA</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Futura', 'Century Gothic', AppleGothic, Arial, sans-serif;
            font-size: 11px;
            font-weight: normal;
            line-height: 1.3;
            color: #000;
            background: white;
            padding: 15px;
        }

        .document-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .logo-left, .logo-right {
            width: 80px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #ccc;
            background: #f9f9f9;
        }

        .center-title {
            text-align: center;
            flex: 1;
            margin: 0 20px;
        }

        .center-title h1 {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .center-title .product-info {
            font-size: 10px;
            margin-bottom: 3px;
        }

        .police-section {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 15px;
        }

        .section-title {
            background: #4CAF50;
            color: white;
            padding: 1px 1px;
            font-size: 12px;
            font-weight: bolder;
            margin: 4px 0 2px 0;
            text-transform: uppercase;
            width: 35%;
        }

        .guarantee-row {
            display: flex;
            justify-content: space-between;
            width: 100%;
            box-sizing: border-box;
            margin-bottom: 1px;
            padding: 1px 0;
            border-bottom: 1px dotted #ccc;
            font-size: 13px;
            line-height: 1.2;
        }

        .info-label {
            font-weight: bold;
        }

        .guarantees-section {
            margin: 5px 0;
            font-size: 13px;
        }

        .conditions-section {
            margin: 10px 0;
        }

        .signatures-section {
            display: flex;
            justify-content: space-between;
            margin: 15px 0;
        }

        .signature-box {
            text-align: center;
            width: 150px;
        }

        .signature-line {
            border-bottom: 1px solid #000;
            height: 40px;
            margin-bottom: 5px;
        }

        .footer-info {
            font-size: 8px;
            text-align: center;
            border-top: 1px solid #ccc;
            padding-top: 10px;
            margin-top: 12px;
        }

        .company-info {
            background: #f0f0f0;
            padding: 5px;
            font-size: 7px;
            text-align: center;
            margin-top: 10px;
        }

        @media print {
            body {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }

        .contract-info {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 30px;
        }

        .contract-info h3 {
            color: #2c5aa0;
            margin-bottom: 15px;
            font-size: 16px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
        }

        .info-item {
            display: flex;
            flex-direction: column;
        }

        .info-label {
            font-weight: bold;
            color: #555;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .info-value {
            color: #333;
            font-size: 14px;
        }

        .section {
            margin-bottom: 25px;
        }

        .section h3 {
            color: #2c5aa0;
            border-bottom: 2px solid #e9ecef;
            padding-bottom: 8px;
            margin-bottom: 15px;
            font-size: 16px;
        }

        .customer-info, .contract-details, .financial-details {
            background: white;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            padding: 20px;
        }

        .financial-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 15px;
        }

        .financial-item {
            text-align: center;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 6px;
        }

        .financial-item .label {
            font-size: 12px;
            color: #666;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .financial-item .value {
            font-size: 16px;
            font-weight: bold;
            color: #2c5aa0;
        }

        .signature-section {
            margin-top: 40px;
            display: flex;
            justify-content: space-between;
            align-items: end;
        }

        .signature-box {
            width: 200px;
            text-align: center;
        }

        .signature-line {
            border-bottom: 1px solid #333;
            height: 40px;
            margin-bottom: 10px;
        }

        .signature-label {
            font-size: 12px;
            color: #666;
        }

        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 10px;
            color: #666;
            border-top: 1px solid #dee2e6;
            padding-top: 15px;
        }

        .total-amount {
            background: #2c5aa0;
            color: white;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            margin: 20px 0;
        }

        .total-amount .label {
            font-size: 14px;
            margin-bottom: 5px;
        }

        .total-amount .value {
            font-size: 24px;
            font-weight: bold;
        }

        @media print {
            body {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <!-- L'en-tête est maintenant géré par Puppeteer headerTemplate -->
    
    <!-- Informations police et référence -->
    <div class="guarantee-row" style="margin-top: -15px;">
        <div>Police : <strong><%= contract.police %></strong></div>
        <div>Réf Dossier : <strong><%= contract.reference %></strong></div>
    </div>

    <div class="guarantee-row">
        <div>Agence : <strong><%= agency.name || '-' %></strong></div>
        <div>Bureau : <strong><%= (contract.user && contract.user.office && contract.user.office.officeName) ? contract.user.office.officeName : '-' %></strong></div>
    </div>
    
    <div class="guarantee-row">
        <div>Souscripteur : <strong><%= (contract.contractType === 'HORS_CONVENTION') ? (contract.etablissement || 'HORS CONVENTION') : 'PADME S.A' %></strong></div>
        <div>Téléphone : <strong>(00229) <%= agency.phone || contract.user.phone %></strong></div>
    </div>
    
    <div class="guarantee-row">
        <div>Adresse : <strong><%= agency.address %></strong></div>
        <div></div>
    </div>
    
    <div class="guarantee-row">
        <div>Effet : <strong><%= new Date(contract.dateEff).toLocaleDateString('fr-FR') %></strong></div>
        <div>Durée : <strong><%= contract.duration %> mois</strong></div>
        <div>1re Échéance : <strong><%= new Date(contract.dateEch1).toLocaleDateString('fr-FR') %></strong></div>
        <div>Échéance : <strong><%= new Date(contract.dateEch).toLocaleDateString('fr-FR') %></strong></div>
    </div>

    <!-- Section Informations de l'assuré -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin: 6px 0 2px 0;">
        <div class="section-title" style="margin: 0; width: auto;">INFORMATIONS DE L'ASSURÉ(E)</div>
        <% if(customer.numCustomer){ %>
        <div style="font-size: 13px;">
            Matricule Client : <strong><%= customer.numCustomer %></strong>
        </div>
        <% } %>
    </div>
    <div style="border-bottom: 1px solid #ccc; margin-top: 2px; width: 100%; margin-bottom: 4px;"></div>
   
    <div class="guarantee-row">
        <span style="flex: 1;">Assuré(e) : <strong><%= customer.lastname %> <%= customer.firstname %></strong></span>
    </div>
    <div class="guarantee-row">
        <span>Date de naissance : <strong><%= new Date(customer.birthdate).toLocaleDateString('fr-FR') %></strong></span>
        <span>Lieu de naissance : <strong><%= customer.placeOfBirth || '-' %></strong></span>
    </div>
    <div class="guarantee-row">
        <span>Profession : <strong><%= customer.occupation || '-' %></strong></span>
        <span>Téléphone : <strong><%= customer.phone %></strong></span>
    </div>
    <div class="guarantee-row">
        <span>Adresse : <strong><%= customer.address || '-' %></strong></span>
        <span>Société : <strong><%= contract.etablissement || '-' %></strong></span>
    </div>
    <div class="guarantee-row">
        <span>Email : <strong><%= customer.email || '-' %></strong></span>
        <span>Sexe : <strong><%= customer.gender === 'M' ? 'Masculin' : 'Féminin' %></strong></span>
    </div>

    <!-- Section Garanties et Primes -->
    <div class="section-title">GARANTIES ET PRIMES</div>
    <div style="border-bottom: 1px solid #ccc; margin-top: 2px; width: 100%; margin-bottom: 4px;"></div>
    
    <div class="guarantees-section">
        <div class="guarantee-row" style="width: 100%;">
            <span style="flex: 1.5; white-space: nowrap;">Cumul Capitaux : <strong><%= new Intl.NumberFormat('fr-FR').format(contract.capital) %> FCFA</strong></span>
            <span style="flex: 0.9; text-align: center; white-space: nowrap;">Taux : <strong><%= contract.taux %> %</strong></span>
            <span style="flex: 1.3; text-align: right; white-space: nowrap;">Cumul Primes TTC : <strong><%= new Intl.NumberFormat('fr-FR').format(contract.puttc) %> FCFA</strong></span>
        </div>
        <div class="guarantee-row" style="width: 100%;">
            <span style="flex: 1; white-space: nowrap;">Mode Paiement : <strong>Virement</strong></span>
            <span style="flex: 1.4; text-align: center; white-space: nowrap;">Périodicité : <strong><%= (contract.periodicite && contract.periodicite.libelle) ? contract.periodicite.libelle : '-' %></strong></span>
            <span style="flex: 1.2; text-align: right; white-space: nowrap;">Type Crédit : <strong><%= contract.natureCredit.libelle %></strong></span>
        </div>
    </div>

    <!-- Section Membres Couverts (OBA) -->
    <div class="section-title" style="width: auto; max-width: 50%;">MEMBRES DE LA COUVERTURE</div>
    <div style="border-bottom: 1px solid #ccc; margin-top: 2px; width: 100%; margin-bottom: 6px;"></div>

    <table style="width: 100%; border-collapse: collapse; margin: 4px 0 6px 0; font-size: 11px;">
        <thead>
            <tr style="background-color: #4CAF50; color: white; font-weight: bold; text-align: left;">
                <th style="padding: 2px 4px; border: 1px solid #ddd;">Qualité</th>
                <th style="padding: 2px 4px; border: 1px solid #ddd;">Nom & Prénoms</th>
                <th style="padding: 2px 4px; border: 1px solid #ddd; text-align: center;">Date de naissance</th>
                <th style="padding: 2px 4px; border: 1px solid #ddd; text-align: right;">Capital Garanti</th>
                <th style="padding: 2px 4px; border: 1px solid #ddd; text-align: right;">Prime Individuelle</th>
            </tr>
        </thead>
        <tbody>
            <!-- Assuré Principal -->
            <tr style="border-bottom: 1px solid #ddd;">
                <td style="padding: 2px 4px; border: 1px solid #ddd; font-weight: bold;">Assuré Principal</td>
                <td style="padding: 2px 4px; border: 1px solid #ddd;"><%= customer.lastname %> <%= customer.firstname %></td>
                <td style="padding: 2px 4px; border: 1px solid #ddd; text-align: center;"><%= new Date(customer.birthdate).toLocaleDateString('fr-FR') %></td>
                <td style="padding: 2px 4px; border: 1px solid #ddd; text-align: right;">500 000 FCFA</td>
                <td style="padding: 2px 4px; border: 1px solid #ddd; text-align: right;">2 000 FCFA</td>
            </tr>
            <!-- Membres Secondaires -->
            <% if (contract.insuredMembers && contract.insuredMembers.length > 0) { %>
                <% contract.insuredMembers.forEach(function(member) { %>
                    <tr style="border-bottom: 1px solid #ddd;">
                        <td style="padding: 2px 4px; border: 1px solid #ddd; font-weight: bold;"><%= member.roleLabel %></td>
                        <td style="padding: 2px 4px; border: 1px solid #ddd;"><%= member.lastname %> <%= member.firstname %></td>
                        <td style="padding: 2px 4px; border: 1px solid #ddd; text-align: center;"><%= member.birthdate ? new Date(member.birthdate).toLocaleDateString('fr-FR') : '-' %></td>
                        <td style="padding: 2px 4px; border: 1px solid #ddd; text-align: right;"><%= new Intl.NumberFormat('fr-FR').format(member.capitalAssure) %> FCFA</td>
                        <td style="padding: 2px 4px; border: 1px solid #ddd; text-align: right;"><%= new Intl.NumberFormat('fr-FR').format(member.prime) %> FCFA</td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>

    <!-- Section Questionnaire de santé -->
    <div class="section-title" style="width: auto; max-width: 50%;">QUESTIONNAIRE MEDICAL</div>
    <div style="border-bottom: 1px solid #ccc; margin-top: 2px; width: 100%; margin-bottom: 4px;"></div>

    <div style="margin: 2px 0;">
        <img src="<%= questionnaireImage %>" alt="Questionnaire de santé" style="width: 100%; height: auto;">
    </div>

    <div style="border-bottom: 1px solid #ccc; margin-top: 4px; width: 100%;"></div>
    
    <div style="padding-top: 4px;">
        <table border="0" width="100%" style="font-size: 9pt; border-collapse: collapse;">
            <tr>
                <td width="33%"><b><u>L'ASSURE(E)</u></b><br><small>Préceder de "Lu et Approuvé"</small></td>
                <td width="33%" style="text-align: center;"><b><u><%= (contract.contractType === 'HORS_CONVENTION') ? (contract.etablissement || 'HORS CONVENTION') : 'PADME S.A' %></u></b></td>
                <td width="33%" style="text-align: right;"><b><u>L'AFRICAINE VIE BENIN</u></b></td>
            </tr>
        </table>
    </div>

    <div style="padding-top: 0px;">
        <table border="0" width="100%" style="font-size: 9pt; border-collapse: collapse;">
            <tr>
                <td width="100%" style="text-align: right;"><img src="<%= signatureImage %>" alt="L'Africaine vie Bénin" width="120" height="40" border="0"/></td>
            </tr>
        </table>
    </div>

    <!-- Le footer Puppeteer apparaîtra automatiquement ici -->
</body>
</html>
